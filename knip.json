{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": [".semgrep/**"],
  "ignoreBinaries": ["uv"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts!", "scripts/**/*.test.ts"]
    },
    "apps/api": {
      "entry": [
        "evals/providers/*.ts",
        "evals/asserts/*.ts",
        "evals/datasets/golden-tests.ts",
        "evals/scripts/*.ts"
      ],
      "project": ["src/**/*.ts!", "test/**/*.ts", "evals/**/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/web": {
      "entry": ["src/app/**/*.{ts,tsx}!"],
      "project": ["src/**/*.{ts,tsx}!"]
    },
    "packages/shared": {
      "entry": ["src/*/index.ts!"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    }
  }
}
