# (`src/**/coverage/`) também se chamam `coverage`.
/coverage/
/apps/*/coverage/
/packages/*/coverage/
coverage-integration/
reports/
.stryker-tmp/
test-results/
playwright-report/
blob-report/
.lighthouseci/

# Python (tools/ingest)
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
.coverage
.hypothesis/
htmlcov/

# Ambiente e segredos (nunca commitar)
.env
.env.*
!.env.example
*.pem
*.key

# Vercel (vercel pull/build)
.vercel/
# Estado da guarda de uso (scripts/vercel-usage.ts; no CI, fica no cache do Actions)
/.vercel-usage/

# Binário do posthog-cli (tools/posthog-cli/install-binary.mjs, sha256 conferido)
/tools/posthog-cli/bin/

# Editores e SO
.DS_Store
Thumbs.db
.idea/
*.swp

# Cookie da sessão de teste da stack de CI (infra/ci/up.sh, local)
/infra/ci/.e2e.env

# Snippets do Caddy da stack de CI (gerados por scripts/caddy-static-site.ts)
/infra/ci/.static-site.caddy
