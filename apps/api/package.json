{
  "name": "@teko/api",
  "version": "0.0.0",
  "private": true,
  "description": "API do Tekó: Fastify com toda a regra de negócio (arquitetura hexagonal)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#domain/*": "./src/domain/*",
    "#app/*": "./src/application/*",
    "#adapters/*": "./src/adapters/*"
  },
  "scripts": {
    "dev": "node ../../scripts/dev-watch.ts --watch src --watch ../../packages/shared/src -- --env-file-if-exists=.env src/server.ts",
    "build": "tsdown",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration --coverage --outputFile.junit=reports/junit-integration.xml",
    "test:mutation": "stryker run",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "type-coverage": "type-coverage --at-least 99 --strict --ignore-catch",
    "cli": "node --env-file-if-exists=.env src/cli.ts",
    "seed:fixtures": "node --env-file-if-exists=.env src/cli.ts seed-fixtures --migrate",
    "fixtures:embed": "node --env-file-if-exists=.env evals/scripts/fixtures-embed.ts",
    "db:generate": "drizzle-kit generate",
    "test:sql-perf": "vitest run --project sql-perf",
    "eval:retrieval": "promptfoo eval -c evals/retrieval/promptfooconfig.yaml --no-cache --no-write --no-progress-bar --no-table -o reports/retrieval-evals.json",
    "eval:retrieval:check": "node evals/scripts/check-thresholds.ts reports/retrieval-evals.json retrieval",
    "eval:retrieval:check:corpus": "node evals/scripts/check-thresholds.ts reports/retrieval-evals.json retrieval-corpus",
    "eval:retrieval:holdout": "promptfoo eval -c evals/retrieval/holdout.promptfooconfig.yaml --no-cache --no-write --no-progress-bar --no-table -o reports/retrieval-evals-holdout.json",
    "eval:retrieval:check:holdout": "node evals/scripts/check-thresholds.ts reports/retrieval-evals-holdout.json retrieval-holdout",
    "eval:retrieval:ajuste": "promptfoo eval -c evals/retrieval/ajuste.promptfooconfig.yaml --no-cache --no-write --no-progress-bar --no-table -o reports/retrieval-evals-ajuste.json",
    "eval:retrieval:check:ajuste": "node evals/scripts/check-thresholds.ts reports/retrieval-evals-ajuste.json retrieval-ajuste",
    "eval:corpus:record": "node evals/scripts/corpus-eval-record.ts",
    "seed:dev-session": "node --env-file-if-exists=.env src/cli.ts seed-dev-session",
    "openapi:export": "node src/cli.ts openapi export"
  },
  "dependencies": {
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/groq": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/otel": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@fastify/sensible": "catalog:",
    "@fastify/static": "catalog:",
    "@fastify/swagger": "catalog:",
    "@fastify/under-pressure": "catalog:",
    "@langfuse/otel": "catalog:",
    "@langfuse/tracing": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@opentelemetry/exporter-logs-otlp-http": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@scalar/fastify-api-reference": "catalog:",
    "@teko/shared": "workspace:*",
    "@vercel/functions": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "close-with-grace": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "htmlparser2": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fast-check/vitest": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "drizzle-kit": "catalog:",
    "fast-check": "catalog:",
    "pino-pretty": "catalog:",
    "promptfoo": "catalog:",
    "tsdown": "catalog:",
    "type-coverage": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
