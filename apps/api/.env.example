# Variáveis da API (@teko/api). Copie para apps/api/.env (fora do git) ou rode `pnpm dev:secrets`.
# Validadas no boot por src/config/env.ts: qualquer valor inválido derruba o processo antes de
# abrir a porta. Este arquivo não contém segredos.

# --- Obrigatórias -------------------------------------------------------------------------------
# development | ci | staging | production
APP_ENV=development
# Origem exata da web (sem caminho nem barra final); única origem aceita pelo CORS do stream.
# Em staging/produção precisa ser https (https://develop--tekoia.netlify.app, https://tekoia.netlify.app).
WEB_ORIGIN=http://localhost:3000

# --- Processo -----------------------------------------------------------------------------------
# development | test | production. APP_ENV=development com NODE_ENV=production é proibido;
# staging e produção exigem NODE_ENV=production (a imagem Docker já define).
# NODE_ENV=development
# HOST=0.0.0.0
# PORT=4000
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
# Saída legível com pino-pretty (só em development; pino-pretty é devDependency).
# LOG_PRETTY=true

# --- Identidade do build (o deploy injeta; /healthz devolve os dois) ---------------------------
# APP_VERSION=0.0.0
# GIT_SHA=unknown

# --- Plataforma ---------------------------------------------------------------------------------
# node (padrão só em development e ci: pnpm dev, stack de CI, Docker) | vercel (teko-api,
# teko-api-staging) | render (Plano B). Em staging e produção é obrigatória e explícita (vercel ou
# render; node é proibido): sem ela o boot falha, em vez de subir no perfil do CI. Com a variável
# de sistema VERCEL=1 (build e runtime da Vercel) só vercel é aceito.
# RUNTIME_TARGET=node
# Proxies confiáveis para X-Forwarded-*: número de saltos (ex.: 1) ou IPs/CIDRs separados por
# vírgula. Padrão em node (só development e ci): a rede do Caddy (172.30.0.0/24). Proibida em
# vercel (1 salto, fixo no código); obrigatória em render (valor medido no ensaio do Plano B).
# TRUST_PROXY=172.30.0.0/24
# Só em vercel: precisa ser igual ao maxDuration efetivo da Function (padrão e teto do Hobby: 300).
# FUNCTION_MAX_DURATION_S=300
# VERCEL e VERCEL_REGION são variáveis de sistema da Vercel (VERCEL=1 exige RUNTIME_TARGET=vercel;
# a região precisa ser gru1 em staging e produção); não defina.

# --- Encerramento gracioso (SIGTERM; em vercel o perfil é fixo: 450 ms) ------------------------
# Teto total do encerramento (>= 30000; abaixo do stop_grace_period de 110 s da stack de CI).
# SHUTDOWN_GRACE_MS=105000
# Espera com /healthz em 503 antes de fechar a porta, para o proxy da frente parar de mandar tráfego.
# DRAIN_DELAY_MS=5000

# --- Banco (F2) ---------------------------------------------------------------------------------
# Runtime: URL do -pooler do Neon com o role teko_app (timeouts de 5 s gravados no role). Local:
# o Postgres do infra/local (`pnpm dev:secrets` grava). Opcional até a F4; sem ela a API não monta
# a busca. CLI (seed-fixtures, ingestão): URL DIRETA do owner.
# DATABASE_URL=postgres://teko:<senha>@127.0.0.1:5432/teko
# DATABASE_MAX_CONNECTIONS=3
# Maior RRF abaixo do qual a pergunta é recusada como no_evidence (0 = só retrieval vazio recusa).
# MIN_EVIDENCE_RRF=0

# --- Provedores (F2+) ---------------------------------------------------------------------------
# gemini | groq | fake (fake é proibido em staging/produção)
# LLM_PROVIDER=fake
# workers-ai | fake (fake é proibido em staging/produção). Obrigatória com DATABASE_URL.
# EMBEDDINGS_PROVIDER=fake
# Fake: vetores BGE-M3 reais da fixture, por content_hash (`pnpm --filter @teko/api fixtures:embed`).
# EMBEDDINGS_FIXTURE_PATH=test/fixtures/corpus/embeddings.json.gz
# true = texto fora da fixture falha (evals e e2e); false = vetor determinístico semeado pelo hash.
# EMBEDDINGS_FAKE_STRICT=false
# Workers AI (escopo só Workers AI; segredo do environment, nunca no repositório).
# CF_ACCOUNT_ID=
# CF_AI_TOKEN=
# Nunca defina *_BASE_URL/*_API_BASE de provedor (OPENAI_BASE_URL, GROQ_BASE_URL,
# GOOGLE_GEMINI_BASE_URL...): o boot falha de propósito.

# --- Ingestão (F3: cli ingest/snapshot/eval-fixture; só no Actions e localmente) ---------------
# Nunca na API publicada: com RUNTIME_TARGET=vercel ou render, NETLIFY_AUTH_TOKEN e
# NEON_API_KEY_STAGING derrubam o boot. A CLI usa DATABASE_URL (URL DIRETA do owner) e
# EMBEDDINGS_PROVIDER=workers-ai com CF_ACCOUNT_ID/CF_AI_TOKEN (acima).
# Netlify Blobs (site tekoia, stores corpus-*): PAT (segredo do environment staging) e o ID (UUID)
# do site (variável NETLIFY_SITE_ID). Vêm juntas; sem as duas, a CLI usa o store em memória.
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=
# Orçamento diário de neurons da ingestão (0 a 10000; o plano reserva 8000 dos 10k/dia da conta).
# EMBED_NEURON_BUDGET=8000
# Guarda de tamanho do banco em bytes (padrão 800 MB; o Neon Free tem 1 GB).
# INGEST_MAX_DB_BYTES=838860800
# Bytes por chunk novo na guarda prospectiva (≈ 10,6 KB medidos no staging).
# INGEST_BYTES_PER_CHUNK=10854
# API do Neon para medir as CU-h do run no staging (vêm juntas; sem elas, cu_seconds fica nulo).
# NEON_API_KEY_STAGING=
# NEON_STAGING_PROJECT_ID=
