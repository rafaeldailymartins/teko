{
  "name": "@teko/web",
  "version": "0.0.0",
  "private": true,
  "description": "Frontend do Tekó: Next.js em export estático, servido pela Vercel na mesma origem da API",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/postbuild.ts",
    "typecheck": "tsc -p tsconfig.json --incremental false",
    "test:unit": "vitest run --coverage",
    "type-coverage": "type-coverage --at-least 99 --strict --ignore-catch",
    "test:e2e": "playwright test",
    "api:generate": "pnpm --filter @teko/api openapi:export && openapi-ts"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@base-ui/react": "catalog:",
    "@streamdown/code": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@teko/shared": "workspace:*",
    "ai": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "nuqs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "catalog:",
    "rehype-harden": "catalog:",
    "streamdown": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "happy-dom": "catalog:",
    "htmlparser2": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "type-coverage": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
