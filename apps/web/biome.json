{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "domains": {
          "react": "recommended",
          "next": "recommended"
        },
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Chamadas à API só em src/lib/api: use o cliente gerado (ou o transporte do chat), que converte erros em ApiError."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "next/server",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "pg",
                      "better-auth",
                      "better-auth/**"
                    ],
                    "message": "apps/web é só frontend (export estático): sem código de servidor nem banco. A lógica fica no Fastify."
                  },
                  {
                    "group": ["posthog-js", "posthog-js/**", "@posthog/**"],
                    "message": "O SDK de analytics só entra pelo adapter em src/lib/analytics (import() depois do consentimento LGPD)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/analytics/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "next/server",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "pg",
                      "better-auth",
                      "better-auth/**"
                    ],
                    "message": "apps/web é só frontend (export estático): sem código de servidor nem banco. A lógica fica no Fastify."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    }
  ]
}
