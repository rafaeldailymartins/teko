{
  "$comment": [
    "Regras custom do WAF da Vercel por projeto (Hobby: 3 regras custom, das quais 1 de rate limit).",
    "Cada item de 'rules' é o payload aceito por `vercel firewall rules add --data '<json>' --yes`",
    "(Vercel CLI >= 65.11.0, em tools/vercel-cli) e pela API REST de firewall (PATCH",
    "/v1/security/firewall/config, action 'rules.insert'). A aplicação é feita na F7; o smoke confere",
    "o efeito. Nenhuma regra usa 'challenge'. Web e API na mesma origem (ADR 0029): todo navegador",
    "chega direto à borda, então o IP de cada requisição é o do cliente e o rate limit por IP vale.",
    "Regra 1: o estático passa (a CDN serve sem invocar a Function); em /api/* só os prefixos",
    "conhecidos (no staging, também /api/docs). Regra 2: o estático só aceita GET e HEAD. Regra 3:",
    "a única de rate limit do Hobby, no stream; as demais rotas usam o rate limit da aplicação."
  ],
  "projects": {
    "tekoia": {
      "rules": [
        {
          "name": "deny-unknown-api",
          "description": "Nega /api/* fora de /api/healthz, /api/auth/* e /api/v1/* (sem invocar a Function). O estático passa.",
          "active": true,
          "conditionGroup": [
            {
              "conditions": [
                {
                  "type": "path",
                  "op": "re",
                  "value": "^/api(?:/|$)"
                },
                {
                  "type": "path",
                  "op": "re",
                  "value": "^/api/(?:healthz|auth/.*|v1/.*)$",
                  "neg": true
                }
              ]
            }
          ],
          "action": {
            "mitigate": {
              "action": "deny",
              "rateLimit": null,
              "redirect": null,
              "actionDuration": null
            }
          }
        },
        {
          "name": "deny-unsafe-static",
          "description": "Nega métodos diferentes de GET e HEAD fora de /api/* e /healthz: o estático só é lido.",
          "active": true,
          "conditionGroup": [
            {
              "conditions": [
                {
                  "type": "method",
                  "op": "inc",
                  "value": ["GET", "HEAD"],
                  "neg": true
                },
                {
                  "type": "path",
                  "op": "re",
                  "value": "^/(?:api(?:/|$)|healthz$)",
                  "neg": true
                }
              ]
            }
          ],
          "action": {
            "mitigate": {
              "action": "deny",
              "rateLimit": null,
              "redirect": null,
              "actionDuration": null
            }
          }
        },
        {
          "name": "rate-limit-stream",
          "description": "POST do stream: 10 requests por IP em janela fixa de 60 s; acima disso, 429.",
          "active": true,
          "conditionGroup": [
            {
              "conditions": [
                {
                  "type": "method",
                  "op": "eq",
                  "value": "POST"
                },
                {
                  "type": "path",
                  "op": "re",
                  "value": "^/api/v1/questions/[^/]+/stream$"
                }
              ]
            }
          ],
          "action": {
            "mitigate": {
              "action": "rate_limit",
              "rateLimit": {
                "algo": "fixed_window",
                "window": 60,
                "limit": 10,
                "keys": ["ip"],
                "action": "rate_limit"
              },
              "redirect": null,
              "actionDuration": null
            }
          }
        }
      ]
    },
    "tekoia-staging": {
      "rules": [
        {
          "name": "deny-unknown-api",
          "description": "Nega /api/* fora de /api/healthz, /api/auth/*, /api/v1/* e /api/docs* (sem invocar a Function). O estático passa.",
          "active": true,
          "conditionGroup": [
            {
              "conditions": [
                {
                  "type": "path",
                  "op": "re",
                  "value": "^/api(?:/|$)"
                },
                {
                  "type": "path",
                  "op": "re",
                  "value": "^/api/(?:healthz|auth/.*|v1/.*|docs(?:/.*)?)$",
                  "neg": true
                }
              ]
            }
          ],
          "action": {
            "mitigate": {
              "action": "deny",
              "rateLimit": null,
              "redirect": null,
              "actionDuration": null
            }
          }
        },
        {
          "name": "deny-unsafe-static",
          "description": "Nega métodos diferentes de GET e HEAD fora de /api/* e /healthz: o estático só é lido.",
          "active": true,
          "conditionGroup": [
            {
              "conditions": [
                {
                  "type": "method",
                  "op": "inc",
                  "value": ["GET", "HEAD"],
                  "neg": true
                },
                {
                  "type": "path",
                  "op": "re",
                  "value": "^/(?:api(?:/|$)|healthz$)",
                  "neg": true
                }
              ]
            }
          ],
          "action": {
            "mitigate": {
              "action": "deny",
              "rateLimit": null,
              "redirect": null,
              "actionDuration": null
            }
          }
        },
        {
          "name": "rate-limit-stream",
          "description": "POST do stream: 10 requests por IP em janela fixa de 60 s; acima disso, 429.",
          "active": true,
          "conditionGroup": [
            {
              "conditions": [
                {
                  "type": "method",
                  "op": "eq",
                  "value": "POST"
                },
                {
                  "type": "path",
                  "op": "re",
                  "value": "^/api/v1/questions/[^/]+/stream$"
                }
              ]
            }
          ],
          "action": {
            "mitigate": {
              "action": "rate_limit",
              "rateLimit": {
                "algo": "fixed_window",
                "window": 60,
                "limit": 10,
                "keys": ["ip"],
                "action": "rate_limit"
              },
              "redirect": null,
              "actionDuration": null
            }
          }
        }
      ]
    }
  }
}
