# Proxy assinado de desenvolvimento (127.0.0.1:8787).
#
# Simula o redirect `signed` da Netlify (/api/* -> API com o header x-nf-sign), para que o
# `next dev` (rewrite /api/* -> http://localhost:8787) fale com a API local (`pnpm dev`, :4000)
# do mesmo jeito que o front publicado fala com a API na Vercel (via proxy assinado da Netlify):
# - x-nf-sign: JWS HS256 estático gerado por `pnpm dev:secrets` (deploy_context=dev, exp +7 dias);
# - x-nf-client-connection-ip e x-nf-request-id, como a Netlify injeta;
# - corpo de até 32 KB (mesmo limite do Fastify em produção);
# - corte em 26 s até o primeiro byte, aproximando o timeout de proxy da Netlify.
# Os valores enviados pelo cliente nesses headers são sobrescritos, nunca repassados.
{
	admin off
	auto_https off
}

:8787 {
	log {
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>X-Nf-Sign delete
		}
	}

	# Healthcheck do próprio contêiner; não toca a API.
	handle /_proxy/healthz {
		respond "ok" 200
	}

	handle /api/* {
		request_body {
			max_size 32KB
		}
		reverse_proxy host.docker.internal:4000 {
			header_up X-Nf-Sign {env.DEV_STATIC_JWS}
			header_up X-Nf-Client-Connection-Ip {remote_host}
			header_up X-Nf-Request-Id {http.request.uuid}
			# Nunca repassa o X-Request-Id do cliente (a API confia nele como id de correlação).
			header_up X-Request-Id {http.request.uuid}
			flush_interval -1
			transport http {
				response_header_timeout 26s
			}
		}
	}

	# A Netlify só faz proxy de /api/*; o restante é servido pelo `next dev` em :3000.
	handle {
		respond "Tekó dev proxy: só /api/* é encaminhado" 404
	}
}
