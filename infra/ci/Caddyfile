# Frente da stack de CI: a mesma origem da Vercel (ADR 0029). `/api/*` e `/healthz` vão para a API;
# o resto é o export estático do web, com a mesma semântica das rotas da Vercel: headers de
# segurança, CSP por documento, redirect da raiz por Accept-Language, barra final, 404 por locale e
# `/_next/static/*` imutável. Os snippets vêm de `scripts/caddy-static-site.ts` (a política do
# `policy.ts` e o manifesto do export), gerados pelo `up.sh` em `infra/ci/.static-site.caddy`.
{
	admin off
	auto_https off
}

import /etc/caddy/static-site.caddy

:8080 {
	# Mesmo limite de corpo da API (BODY_LIMIT_BYTES) e do Hobby.
	request_body {
		max_size 32KB
	}

	@api path /api /api/* /healthz
	handle @api {
		reverse_proxy api:4000 {
			# O request id do Caddy chega à API e volta no x-request-id.
			header_up X-Request-Id {http.request.uuid}
		}
	}

	handle {
		import teko_static
	}

	# Arquivo inexistente no export: a página de 404 do locale, com status 404 (as respostas da API
	# não passam por aqui; o 404 dela é problem+json).
	handle_errors 404 {
		import teko_not_found
	}
}
