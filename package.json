{
  "name": "teko",
  "version": "0.0.0",
  "private": true,
  "description": "Tekó — assistente RAG sobre legislação fiscal brasileira com consciência de vigência",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.scripts.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "turbo run test:unit test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:scripts": "node --test \"scripts/**/*.test.ts\"",
    "test:mutation": "turbo run test:mutation",
    "lint": "biome ci --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint:deps": "turbo run lint:deps",
    "lint:monorepo": "sherif",
    "knip": "knip && knip --production --include dependencies,unlisted,unresolved,binaries",
    "type-coverage": "turbo run type-coverage",
    "dup": "jscpd",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "check-lockfile": "node scripts/check-lockfile.ts",
    "verify": "pnpm lint && pnpm check-lockfile && pnpm lint:monorepo && pnpm spec:validate && pnpm dup && pnpm knip && pnpm typecheck:scripts && turbo run typecheck lint:deps type-coverage test:unit",
    "verify:full": "pnpm verify && pnpm test:scripts && turbo run test:integration build && pnpm verify:ci && pnpm verify:python && pnpm verify:audit",
    "verify:ci": "bash .github/scripts/affected.test.sh && bash .github/scripts/ci-config.test.sh && bash .github/scripts/migration-guard.test.sh",
    "verify:python": "cd tools/ingest && uv run --frozen ruff check . && uv run --frozen ruff format --check . && uv run --frozen pyright && uv run --frozen pytest",
    "verify:audit": "pnpm audit --prod --audit-level low && pnpm --dir tools/vercel-cli audit --audit-level low",
    "dev:secrets": "node scripts/dev-secrets.ts",
    "changelog": "git-cliff --output CHANGELOG.md"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@fission-ai/openspec": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "git-cliff": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "sherif": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
