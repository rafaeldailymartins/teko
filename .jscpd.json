{
  "threshold": 3,
  "minTokens": 70,
  "reporters": ["console"],
  "absolute": true,
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "apps/web/out/**",
    "**/.next/**",
    "**/__generated__/**",
    "**/drizzle/migrations/**",
    "**/test/fixtures/**",
    "**/*.json",
    "**/*.md",
    "pnpm-lock.yaml"
  ],
  "path": ["apps", "packages", "scripts"]
}
